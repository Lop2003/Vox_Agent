<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- voxagent://pair?code=…: the Mac app's QR code, scanned with the Camera, opens the app and pairs. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.voxagent.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>voxagent</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Vox Agent uses the camera only to scan the pairing QR code shown by the Mac app.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_voxcode._tcp</string>
	</array>
</dict>
</plist>
